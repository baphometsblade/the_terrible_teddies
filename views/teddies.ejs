<!DOCTYPE html>
<html lang="en">
<%- include('partials/_head.ejs', { pageTitle: 'Your Collection - Terrible Teddies' }) %>
  <%# The .teddy-card:hover rule moved to /css/style.css. The CSP sets
      style-src 'self' with no unsafe-inline, so an inline <style> block
      never applied. %>
  <body>
    <%- include('partials/_nav.ejs') %>
    <main role="main" class="container">
      <h1>Your Teddies</h1>
      <div id="teddies-collection" class="row">
        <% teddies.forEach(function(teddy) { %>
          <% const picture = (locals.art && locals.art[String(teddy._id)]) || {}; %>
          <div class="col-md-4">
            <div class="card mb-4 shadow-sm teddy-card" data-teddy-id="<%= teddy._id %>">
              <%# Artwork is resolved on the server (services/teddyAssets.js), by
                  teddy name rather than _id. A teddy with none gets a drawn
                  placeholder instead of a request that can only 404.
                  imageFallback.js still covers a file that exists but fails to
                  load; an inline onerror would be blocked by the CSP. %>
              <% if (picture.imageUrl) { %>
                <img id="img-<%= teddy._id %>" src="<%= picture.imageUrl %>" class="card-img-top" alt="<%= teddy.name %>">
              <% } else { %>
                <div id="img-<%= teddy._id %>" class="teddy-img-placeholder card-img-top" role="img" aria-label="<%= teddy.name %>"><%= picture.initials || '?' %></div>
              <% } %>
              <div class="card-body">
                <h5 class="card-title"><%= teddy.name %></h5>
                <p class="card-text"><%= teddy.description %></p>
                <ul class="list-unstyled">
                  <li>Attack Damage: <%= teddy.attackDamage %></li>
                  <li>Health: <%= teddy.health %></li>
                  <li>Special Move: <%= teddy.specialMove %></li>
                  <li>Rarity: <%= teddy.rarity %></li>
                </ul>
                <div class="d-flex justify-content-between align-items-center">
                  <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary select-teddy" data-teddy-id="<%= teddy._id %>">Select</button>
                  </div>
                  <small class="text-muted"><%= teddy.rarity %> Rarity</small>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
      <%# action="/battle" had no handler, so this 404'd. battleLogic.js now
          intercepts submit and drives the real two-step server flow:
          POST /game/choose-lineup then POST /game/initiate-battle. The action
          points at the first of those as a no-JS fallback. %>
      <form id="lineup-form" action="/game/choose-lineup" method="post">
        <input type="hidden" name="selectedTeddyIds" id="selectedTeddyIds" value="">
        <button type="submit" class="btn btn-primary">Initiate Battle</button>
      </form>
    </main>
    <%- include('partials/_footer.ejs') %>
    <script src="/js/imageFallback.js"></script>
    <script src="/js/battleLogic.js"></script>
  </body>
</html>
