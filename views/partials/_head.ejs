<%#
  Shared <head>. A view includes it once, straight after <html>, and passes
  { pageTitle, pageDescription } through include(). Both are escaped, so a
  value that came from the database is safe here. Anything left out falls back
  to the site defaults below. A view must not write its own <head> or <title>;
  test/viewHead.test.js enforces that, and that every page declares a viewport.
%>
<%
  const siteName = 'Terrible Teddies';
  const headTitle = locals.pageTitle || siteName;
  const headDescription = locals.pageDescription ||
    'Terrible Teddies is a strategic teddy card battler. Pick a fighter, enter the fluff pit and play the demo in your browser.';
%>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= headTitle %></title>
  <meta name="description" content="<%= headDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= headTitle %>">
  <meta property="og:description" content="<%= headDescription %>">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof adventureTimeStyle !== 'undefined' && adventureTimeStyle) { %>
    <link rel="stylesheet" href="/css/adventuretime/style.css">
  <% } %>
</head>
