<%#
  Debug toolbar.

  Two problems before: it used style="" attributes, which the CSP blocks
  (style-src 'self' with no unsafe-inline), and it rendered on every page
  that included it - login and register among them - for every visitor,
  with three links to /debug/* routes that do not exist in this app.

  Styling now lives in /css/style.css, and it only renders outside
  production. server.js sets app.locals.showDebugToolbar.
%>
<% if (typeof showDebugToolbar !== 'undefined' && showDebugToolbar) { %>
  <div id="debug-toolbar" class="debug-toolbar">
    <a href="/debug/session">Session State</a>
    <a href="/debug/database">Database Status</a>
    <a href="/debug/logs">Application Logs</a>
  </div>
<% } %>
