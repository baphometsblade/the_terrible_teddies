<%#
  App navigation (the light navbar used by the signed-in pages).

  Three things were wrong before:
    - Login, Register and Logout linked to /login, /register and /logout. The
      routes are /auth/login, /auth/register and /auth/logout, so all three 404'd.
    - The toggler used Bootstrap 4 attributes (data-toggle, data-target) and the
      site loads Bootstrap 5, so the menu never opened on a narrow screen.
    - It tested a `user` local that each route passed differently - the whole
      session object in one, session.user in another - so "signed in" meant
      three different things. server.js now sets `currentUser` for every view.
%>
<nav class="navbar navbar-expand-lg navbar-light bg-light px-3">
  <a class="navbar-brand" href="/">Terrible Teddies</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" href="/">Home</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/teddies">Teddies</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/market">Marketplace</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/challenges">Challenges</a>
      </li>
      <% if (!locals.currentUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/auth/login">Login</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/auth/register">Register</a>
        </li>
      <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/auth/logout">Logout</a>
        </li>
      <% } %>
    </ul>
  </div>
</nav>
