<!DOCTYPE html>
<html lang="en">
<%- include('partials/_head.ejs') %>
<body class="tt-body">
  <%- include('partials/_header.ejs') %>

  <main class="tt-shell">
    <section class="tt-hero">
      <p class="tt-kicker">Playable Web Demo</p>
      <h1>Terrible Teddies: Battle of the Bear-ristocrats</h1>
      <p class="tt-lede">Pick a teddy, enter the fluff pit, and test the core battle loop. This demo runs without a database so the game can launch locally, on Render, Railway, Fly.io, or any Node host.</p>
      <div class="tt-actions">
        <a class="tt-button tt-button-primary" href="#choose">Choose Fighter</a>
        <% if (founderPackUrl) { %>
          <a class="tt-button tt-button-pay" href="<%= founderPackUrl %>" target="_blank" rel="noreferrer">Buy Founder Pack</a>
        <% } else { %>
          <span class="tt-button tt-button-muted">Set FOUNDER_PACK_URL to enable payments</span>
        <% } %>
      </div>
      <% if (demoMode) { %>
        <p class="tt-demo-note">Demo mode is active. MongoDB is optional for this route.</p>
      <% } %>
    </section>

    <section id="choose" class="tt-grid">
      <% teddies.forEach(function(teddy) { %>
        <article class="tt-card <%= selectedTeddyId === teddy._id ? 'is-selected' : '' %>">
          <div class="tt-card-art"><%= teddy.name.split(' ').map(function(part){ return part[0]; }).join('').slice(0, 3) %></div>
          <div class="tt-card-body">
            <p class="tt-rarity"><%= teddy.rarity %></p>
            <h2><%= teddy.name %></h2>
            <p><%= teddy.description %></p>
            <dl class="tt-stats">
              <div><dt>HP</dt><dd><%= teddy.health %></dd></div>
              <div><dt>ATK</dt><dd><%= teddy.attackDamage %></dd></div>
              <div><dt>Move</dt><dd><%= teddy.specialMove %></dd></div>
            </dl>
            <form action="/play/start" method="post">
              <input type="hidden" name="teddyId" value="<%= teddy._id %>">
              <button class="tt-button tt-button-primary" type="submit">Fight With <%= teddy.name %></button>
            </form>
          </div>
        </article>
      <% }); %>
    </section>

    <% if (battle) { %>
      <section class="tt-battle-panel" aria-live="polite">
        <div class="tt-fighters">
          <article>
            <h2><%= battle.player.name %></h2>
            <progress max="<%= battle.player.maxHealth %>" value="<%= battle.player.health %>"></progress>
            <p><%= battle.player.health %> / <%= battle.player.maxHealth %> HP</p>
          </article>
          <strong>VS</strong>
          <article>
            <h2><%= battle.opponent.name %></h2>
            <progress max="<%= battle.opponent.maxHealth %>" value="<%= battle.opponent.health %>"></progress>
            <p><%= battle.opponent.health %> / <%= battle.opponent.maxHealth %> HP</p>
          </article>
        </div>

        <% if (battle.status === 'active') { %>
          <form class="tt-actions" action="/play/turn" method="post">
            <button class="tt-button tt-button-primary" name="move" value="attack" type="submit">Basic Bonk</button>
            <button class="tt-button tt-button-pay" name="move" value="special" type="submit"><%= battle.player.specialMove %></button>
          </form>
        <% } else { %>
          <div class="tt-result">
            <h2><%= battle.winner === 'player' ? 'Victory' : 'Defeat' %></h2>
            <p><%= battle.winner === 'player' ? 'You won the fluff pit. Push Founder Packs now.' : 'You lost, but the rematch button is free.' %></p>
            <a class="tt-button tt-button-primary" href="/play">Play Again</a>
          </div>
        <% } %>

        <ol class="tt-log">
          <% battle.log.slice().reverse().forEach(function(entry) { %>
            <li><%= entry %></li>
          <% }); %>
        </ol>
      </section>
    <% } %>
  </main>

  <%- include('partials/_footer.ejs') %>
</body>
</html>
