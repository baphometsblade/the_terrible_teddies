# Copy this file to .env and edit the settings.

# Hosting platforms usually inject PORT automatically.
PORT=3000

# Required only for full account persistence. The /play demo runs without this when DEMO_MODE=true.
DATABASE_URL=

# Change this in production.
SESSION_SECRET=change-this-to-a-long-random-secret

# Run the guaranteed playable demo without MongoDB.
DEMO_MODE=true

# Optional payment, Patreon, Ko-fi, Stripe Payment Link, Gumroad, or store URL shown on /play.
FOUNDER_PACK_URL=

# Set true only when your host terminates HTTPS correctly and you want secure cookies forced.
FORCE_SECURE_COOKIES=false
