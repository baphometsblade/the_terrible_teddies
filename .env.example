# Copy this file to .env and edit the settings.
#
# Never commit .env. It is gitignored for a reason: this repo previously had a
# real .env committed, which exposed live database credentials and the session
# signing key.

# Hosting platforms usually inject PORT automatically.
PORT=3000

# Required only for full account persistence. The /play demo runs without this
# when DEMO_MODE=true.
DATABASE_URL=

# How long startup waits for MongoDB before giving up, in milliseconds. An
# unreachable database (a paused Atlas free-tier cluster, say) stops the boot
# with a message naming the host instead of hanging. Default 10000.
# DB_TIMEOUT_MS=10000

# Must be long and random, and different per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone holding this value can forge session cookies and log in as any user.
SESSION_SECRET=change-this-to-a-long-random-secret

# Run the guaranteed playable demo without MongoDB.
DEMO_MODE=true

# How long a shutdown waits for open connections, in milliseconds. On SIGTERM or
# SIGINT the server stops taking new connections, lets requests in flight finish
# and exits 0. Whatever is still open after this long is cut off and the exit
# code is 1; a second signal exits at once. Render kills the process 30 seconds
# after SIGTERM, so keep this under that. Default 10000.
# SHUTDOWN_GRACE_MS=10000

# Without a database the demo keeps its sessions in memory. This caps how many;
# the oldest unused go first, so abandoned battles cannot fill the server's
# memory. Default 10000.
# DEMO_MAX_SESSIONS=10000

# The rate limits count requests per visitor. Behind a proxy the app has to work
# out which address is the visitor's, and by default it trusts one proxy hop
# (see "trust proxy" in server.js). Where that is wrong, every visitor shares one
# allowance. This names a header your platform's edge writes itself, and that
# address is used instead. Render: True-Client-IP.
#
# Name only a header the platform sets. One a visitor can send is one a visitor
# can forge, and with it the limits. If none of the first 20 requests carries
# the header, the log says so once.
# CLIENT_IP_HEADER=True-Client-IP

# Optional payment, Patreon, Ko-fi, Stripe Payment Link, Gumroad, or store URL
# shown on /play.
FOUNDER_PACK_URL=

# Secure session cookies are ON by default whenever NODE_ENV=production.
# Leave this unset unless you have a specific reason.
#
# Set it to the literal string "false" ONLY for a production host that does not
# terminate HTTPS - doing so sends session cookies over plain HTTP, where they
# can be read in transit.
# FORCE_SECURE_COOKIES=false

# Only for scripts/dalleImageGenerator.js, which looks up a stock photo on
# Unsplash for each teddy. The server never reads it. Unsplash issues the key to
# a registered application.
# UNSPLASH_ACCESS_KEY=

# Only needed to run tests/signedInGame.test.js, which plays the signed-in game
# against a real MongoDB. That database is emptied before the run and dropped
# after it, so its name must end in _test, and the test refuses anything else.
# Never point it at your production database.
# TEST_DATABASE_URL=mongodb://localhost:27017/teddies_test
