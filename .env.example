# Copy this file to .env and edit the settings.
#
# Never commit .env. It is gitignored for a reason: this repo previously had a
# real .env committed, which exposed live database credentials and the session
# signing key.

# Hosting platforms usually inject PORT automatically.
PORT=3000

# Required only for full account persistence. The /play demo runs without this
# when DEMO_MODE=true.
DATABASE_URL=

# Must be long and random, and different per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone holding this value can forge session cookies and log in as any user.
SESSION_SECRET=change-this-to-a-long-random-secret

# Run the guaranteed playable demo without MongoDB.
DEMO_MODE=true

# Optional payment, Patreon, Ko-fi, Stripe Payment Link, Gumroad, or store URL
# shown on /play.
FOUNDER_PACK_URL=

# Secure session cookies are ON by default whenever NODE_ENV=production.
# Leave this unset unless you have a specific reason.
#
# Set it to the literal string "false" ONLY for a production host that does not
# terminate HTTPS - doing so sends session cookies over plain HTTP, where they
# can be read in transit.
# FORCE_SECURE_COOKIES=false

# Only needed to run the integration tests in tests/. Point it at a throwaway
# database, never your production one.
# TEST_DATABASE_URL=
